# Copy to .env and fill in (optional — high-stress MongoDB logs only).
# Atlas: allow your host IP or 0.0.0.0/0 for testing.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.enwyvnr.mongodb.net/Stress_Detection?retryWrites=true&w=majority

# Optional Node.js app settings
PORT=8090
STRESS_INFERENCE_BASE_URL=http://127.0.0.1:8081
STRESS_INTERVAL_MS=5000
STRESS_CHART_HISTORY_SIZE=60
