# Spring Boot API. Build from repo root: Stress_detection/
FROM maven:3.9.9-eclipse-temurin-17 AS build
WORKDIR /build
COPY spring-backend/pom.xml .
COPY spring-backend/src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:17-jre-jammy
WORKDIR /app

COPY --from=build /build/target/iot-stress-backend-*.jar /app/app.jar
COPY balanced_data.csv /data/balanced_data.csv

EXPOSE 8090

ENV STRESS_CSV_PATH=/data/balanced_data.csv
ENV STRESS_INFERENCE_BASE_URL=http://inference:8081

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
