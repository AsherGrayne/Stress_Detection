FROM node:22-alpine

WORKDIR /app

COPY node-app/package*.json ./node-app/
RUN cd node-app && npm ci --omit=dev

COPY node-app/ ./node-app/
COPY balanced_data.csv ./balanced_data.csv

WORKDIR /app/node-app

ENV NODE_ENV=production
ENV PORT=8090
ENV STRESS_CSV_PATH=/app/balanced_data.csv

EXPOSE 8090

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD wget -qO- http://127.0.0.1:8090/api/health >/dev/null || exit 1

CMD ["npm", "start"]
